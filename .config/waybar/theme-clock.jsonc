{
  "clock": {
    "timezone": "Europe/Madrid",
    "tooltip-format": "<tt>{calendar}</tt>",
    "format": "{:%H:%M | %d %B %Y}",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "format": {
        "months": "<span color='#94cef1'><b>{}</b></span>",
        "days": "<span color='#b4cad9'><b>{}</b></span>",
        "weekdays": "<span color='#e3b7f0'><b>{}</b></span>",
        "today": "<span color='#e1e2e5'><b><u>{}</u></b></span>"
      }
    }
  }
}
